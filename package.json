{
  "name": "super-memory",
  "version": "0.1.0",
  "description": "An adaptive AI browser agent that remembers verified workflows, checks website changes, and recovers when saved workflows become outdated.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "cli": "node scripts/super-memory.js",
    "demo": "node --env-file=.env scripts/demo-recovery.js",
    "demo:discover": "node --env-file=.env scripts/demo-discovery.js",
    "demo:discover:offline": "node scripts/demo-discovery.js --offline",
    "demo:offline": "node scripts/demo-recovery.js --offline",
    "fixture": "node scripts/serve-fixture.js",
    "fixture:bookstore": "node scripts/serve-bookstore.js",
    "serve:app": "node scripts/serve-app.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:baseten": "node --env-file=.env scripts/test-baseten.js",
    "test:browser": "node --test \"tests/browser/**/*.test.js\"",
    "test:meta": "node --env-file=.env scripts/test-meta.js",
    "test:models": "node --test \"tests/models/**/*.test.js\"",
    "web:build": "vite build --config web/vite.config.js",
    "web:dev": "vite --config web/vite.config.js"
  },
  "keywords": [
    "ai",
    "agent",
    "browser-agent",
    "workflow-memory",
    "super-memory"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.64.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.5"
  }
}
